{
  "name": "manifest-viewer",
  "version": "1.0.8",
  "license": "MIT",
  "homepage": "https://mv.realeyes.cloud/",
  "repository": {
    "url": "https://github.com/realeyes-media/moe-manifest-viewer"
  },
  "engines": {
    "node": ">=14.0.0 <21.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "ng": "node ./node_modules/.bin/ng",
    "start": "node ./start-dev.js",
    "serve": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng serve --port=4200 --verbose",
    "serve:alt": "cross-env NODE_OPTIONS=--openssl-legacy-provider node ./node_modules/.bin/ng serve --verbose",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider ./node_modules/.bin/ng test",
    "pree2e": "webdriver-manager update",
    "e2e": "cross-env NODE_OPTIONS=--openssl-legacy-provider ./node_modules/.bin/protractor",
    "format:fix": "pretty-quick --staged",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider ./node_modules/.bin/ng build --configuration=production",
    "build-dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider ./node_modules/.bin/ng build --configuration=development",
    "build:only": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng build",
    "serve:dist": "cross-env NODE_OPTIONS=--openssl-legacy-provider http-server ./dist -p 8080",
    "express": "npm run build:only && node server.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run-s format:fix lint"
    }
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "9.1.13",
    "@angular/cli": "9.1.13",
    "@angular/common": "9.1.13",
    "@angular/compiler": "9.1.13",
    "@angular/compiler-cli": "9.1.13",
    "@angular/core": "9.1.13",
    "@angular/forms": "9.1.13",
    "@angular/platform-browser": "9.1.13",
    "@angular/platform-browser-dynamic": "9.1.13",
    "@angular/router": "9.1.13",
    "@tweenjs/tween.js": "17.1.0",
    "buffer": "^6.0.3",
    "chartist": "0.11.0",
    "express": "^4.17.1",
    "chartist-plugin-axistitle": "0.0.7",
    "chartist-plugin-tooltips": "0.0.17",
    "core-js": "3.9.1",
    "downloadjs": "1.4.7",
    "hls-ts": "0.4.4",
    "hls.js": "1.3.2",
    "http-server": "0.12.3",
    "json-view": "0.4.0",
    "material-design-icons": "3.0.1",
    "ng-chartist": "4.1.0",
    "ng-click-outside": "6.0.0",
    "ngx-toastr": "^13.2.1",
    "query-string": "6.13.8",
    "rxjs": "6.6.3",
    "scte35": "0.3.0",
    "shaka-player": "^4.7.1",
    "ts-helpers": "1.1.2",
    "ts-md5": "1.2.7",
    "tslib": "1.10.0",
    "typescript": "3.8.3",
    "ua-parser-js": "0.7.23",
    "yamlparser": "0.0.2",
    "zone.js": "0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "0.901.13",
    "@angular-eslint/builder": "1.2.0",
    "@angular-eslint/eslint-plugin": "1.2.0",
    "@angular-eslint/eslint-plugin-template": "1.2.0",
    "@angular-eslint/schematics": "1.2.0",
    "@angular-eslint/template-parser": "1.2.0",
    "@typescript-eslint/eslint-plugin": "4.16.1",
    "@typescript-eslint/parser": "4.16.1",
    "@types/chartist": "0.11.0",
    "@types/downloadjs": "1.4.2",
    "@types/google.analytics": "0.0.41",
    "@types/hls.js": "0.13.3",
    "@types/jasmine": "2.8.8",
    "@types/node": "14.14.21",
    "cross-env": "7.0.3",
    "eslint": "7.21.0",
    "husky": "4.3.7",
    "jasmine-core": "3.5.0",
    "jasmine-spec-reporter": "4.2.1",
    "karma": "5.0.0",
    "karma-chrome-launcher": "3.1.0",
    "karma-cli": "1.0.1",
    "karma-coverage-istanbul-reporter": "2.1.0",
    "karma-jasmine": "3.0.1",
    "karma-jasmine-html-reporter": "1.4.2",
    "npm-run-all": "4.1.5",
    "prettier": "2.2.1",
    "pretty-quick": "3.1.0",
    "protractor": "7.0.0",
    "ts-node": "8.3.0"
  },
  "browser": {
    "crypto": false,
    "http": false,
    "https": false,
    "fs": false,
    "net": false,
    "path": false,
    "stream": false,
    "tls": false,
    "zlib": false
  }
}
